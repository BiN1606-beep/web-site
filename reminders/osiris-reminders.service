[Unit]
Description=Send Osiris daily check-in reminders
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=__RUN_AS__
EnvironmentFile=/etc/mysite/deploy.env
Environment=VAPID_PRIVATE_KEY_FILE=/etc/mysite/vapid_private.pem
Environment=VAPID_SUBJECT=https://osiris-ai.se
ExecStart=/opt/mysite-reminders/venv/bin/python -I /opt/mysite/reminders/send_reminders.py
